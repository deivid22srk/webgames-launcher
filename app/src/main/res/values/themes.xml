<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base: barras gerenciadas via edge-to-edge no Compose.
         minSdk 29 => windowLayoutInDisplayCutoutMode (API 28) sempre disponível. -->
    <style name="Theme.WebGames" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.WebGames.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WebGames</item>
    </style>
</resources>
